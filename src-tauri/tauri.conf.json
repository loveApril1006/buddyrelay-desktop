{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BuddyRelay",
  "version": "1.7.0",
  "identifier": "io.github.loveapril1006.buddyrelay",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BuddyRelay · WorkBuddy / CodeBuddy 多账号切换 + OpenAI 兼容反代",
        "width": 1000,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 30
        },
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
